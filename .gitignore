# =========================
# 📦 DEPENDENCIES
# =========================
/node_modules
/.pnp
.pnp.js
.pnp.cjs

# =========================
# 🚀 NEXT.JS & BUILD OUTPUTS
# =========================
/.next/
/out/
/build
/dist
*.tsbuildinfo

# =========================
# 🔐 ENVIRONMENT VARIABLES (CRITICAL)
# =========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# =========================
# ⚙️ TRIGGER.DEV
# =========================
# Ignores local v3 dev state (prevents sync conflicts)
.trigger/

# =========================
# 🗄️ PRISMA
# =========================
# Note: Do NOT ignore /prisma/migrations! Those must be committed.
# Ignore local SQLite databases if you ever use them for quick testing
*.db
*.db-journal
*.sqlite
*.sqlite3

# =========================
# ☁️ VERCEL
# =========================
.vercel

# =========================
# 📝 LOGS & DIAGNOSTICS
# =========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/logs
*.log

# =========================
# 🧪 TESTING & COVERAGE
# =========================
/coverage
/.nyc_output

# =========================
# 💻 IDE & EDITORS
# =========================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# =========================
# 🍎 OS GENERATED FILES
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db